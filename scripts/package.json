{
  "name": "canister-hub-release-scripts",
  "private": true,
  "type": "module",
  "description": "Marketplace publishing + setup helper scripts (see README.md).",
  "scripts": {
    "generate": "icp-bindgen --did-file ../backend/backend.did --out-dir ./bindings --actor-disabled --declarations-flat --force",
    "publish": "npm run generate && node publish_to_marketplace.js",
    "upload-catalog": "node upload_marketplace_catalog.js",
    "seed-packages": "node seed_package_infos.js"
  },
  "dependencies": {
    "@dfinity/vetkeys": "0.4.0",
    "@icp-sdk/core": "6.1.0"
  },
  "devDependencies": {
    "@icp-sdk/bindgen": "^0.4.0"
  }
}
