type AiChannel = variant {
  // A customer signed in with Internet Identity on the public storefront
  // (or the agent's web chat); `session_id` is their principal's text.
  Web;
  Email;
  WhatsApp;
  Telegram;
};
type AiContext = record {
  session_id : text;
  agent_canister_id : principal;
  project_id : text;
  channel : AiChannel;
};
type AuditEntry = record {
  at : nat64;
  id : nat64;
  action : text;
  actor : text;
  details : text;
  order_id : opt nat64;
};
type BusinessProfile = record { name : text; currency : text };
type CanisterLink = record { url : text; kind : LinkKind; label : text };
type CanisterType = variant { Storage; Auth; Database; Custom };
type ConfigFieldSchema = record {
  key : text;
  // `Some(true)` means this value is canister-provided display data and
  // cannot be changed through `set_config`. Optional on the wire so new
  // settings clients remain compatible with older module canisters.
  is_readonly : opt bool;
  is_required : bool;
  field_type : ConfigType;
  group_description : opt text;
  description : text;
  label : text;
  // Optional presentation metadata. These are optional on the wire so a
  // new dashboard can still decode schemas from older module canisters.
  group : opt text;
  group_label : opt text;
  // Optional typed filter for canister-picker fields. `None` has the
  // same meaning as `Some(CanisterType::Custom)`.
  canister_type : opt CanisterType;
  // Optional `.wasm` artifact name for a canister dependency. Package
  // installers can use this to prefill the picker from the project's
  // already-installed canisters without matching project canister labels.
  package_name : opt text;
  default_value : opt ConfigValue;
};
type ConfigType = variant {
  // Same stored value as `Text`, presented by settings clients as a
  // multiline text area.
  TextArea;
  Text;
  CanisterPicker : record { module_type_filter : opt text };
  Boolean;
  Float;
  // Same wire shape as `Text`; `get_config` masks the value for every
  // caller (see this module's doc comment - secrets are write-only).
  SecretText;
  Select : record { options : vec text };
  // A repeatable setting whose entries all share one scalar type. The
  // settings UI renders this as a list with per-entry Add/Remove controls.
  Vector : record { element_type : ConfigVectorType };
  Number;
};
type ConfigValue = variant {
  Text : text;
  Boolean : bool;
  Float : float64;
  Vector : vec ConfigVectorValue;
  PrincipalId : principal;
  Number : int64;
};
type ConfigVectorType = variant {
  Text;
  CanisterPicker : record { module_type_filter : opt text };
  Boolean;
  Float;
  SecretText;
  Select : record { options : vec text };
  Number;
};
type ConfigVectorValue = variant {
  Text : text;
  Boolean : bool;
  Float : float64;
  PrincipalId : principal;
  Number : int64;
};
type CreateInventoryItem = record {
  sku : opt text;
  price_minor : nat64;
  // See `InventoryItem::image_url`.
  image_url : opt text;
  kind : InventoryKind;
  name : text;
  description : text;
  // Defaults to cash on delivery for older clients.
  payment_method : opt PaymentMethod;
  currency : text;
  stock_quantity : opt nat64;
};
type CustomerIdentity = record { session_id : text; channel : AiChannel };
type DeliveryLocation = record {
  latitude : opt float64;
  instructions : opt text;
  longitude : opt float64;
  address : text;
};
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
type InventoryItem = record {
  id : nat64;
  sku : opt text;
  updated_at : nat64;
  price_minor : nat64;
  active : bool;
  // Public http(s) URL of the item's picture, normally a file on a
  // separate asset-storage canister. Items stored before this field
  // existed decode as `None`.
  image_url : opt text;
  kind : InventoryKind;
  name : text;
  description : text;
  created_at : nat64;
  // Payment terms selected by the vendor for this item.
  payment_method : PaymentMethod;
  currency : text;
  // `None` means stock is not tracked (normally useful for services).
  stock_quantity : opt nat64;
};
type InventoryKind = variant { Product; Service };
// How a dashboard should present one webpage exposed by a module.
type LinkKind = variant {
  // A public-facing page opened as an ordinary external link.
  Public;
  // An authenticated internal page suitable for the dashboard iframe.
  Admin;
};
type Order = record {
  id : nat64;
  status : OrderStatus;
  updated_at : nat64;
  customer_phone : opt text;
  customer : CustomerIdentity;
  note : opt text;
  amount_paid_minor : nat64;
  created_at : nat64;
  payment_status : PaymentStatus;
  payment_method : PaymentMethod;
  // Agent that created this order, retained for the verified payment
  // receipt callback. Storefront orders have no originating agent.
  agent_canister_id : opt principal;
  stock_released : bool;
  // Prepaid stock is reserved until this timestamp. Cash-on-delivery
  // orders do not expire automatically.
  reservation_expires_at : opt nat64;
  total_minor : nat64;
  currency : text;
  items : vec OrderLine;
  customer_email : opt text;
  customer_name : opt text;
  // Immutable merchant reference supplied to the payment provider.
  payment_reference : opt text;
  // Hosted checkout URL supplied by the configured payment module.
  checkout_url : opt text;
  delivery_location : DeliveryLocation;
  amount_refunded_minor : nat64;
};
type OrderError = variant {
  Internal : text;
  InvalidInput : text;
  NotFound : text;
  Unauthorized : text;
  Conflict : text;
};
type OrderItemRequest = record { quantity : nat64; inventory_id : nat64 };
type OrderLine = record {
  // SKU snapshotted at order placement, like `name`, so the modal and
  // receipts stay accurate if the item is later edited. Lines stored
  // before this field existed decode as `None`.
  sku : opt text;
  kind : InventoryKind;
  name : text;
  line_total_minor : nat64;
  quantity : nat64;
  inventory_id : nat64;
  unit_price_minor : nat64;
};
type OrderStatus = variant {
  AwaitingPayment;
  Confirmed;
  Ready;
  Preparing;
  Cancelled;
  OutForDelivery;
  Completed;
  Expired;
  Pending;
};
type PaymentMethod = variant { Prepaid; CashOnDelivery };
type PaymentRecord = record {
  status : PaymentStatus;
  method : PaymentMethod;
  updated_at : nat64;
  provider : opt text;
  provider_transaction_id : opt text;
  amount_paid_minor : nat64;
  created_at : nat64;
  currency : text;
  expected_amount_minor : nat64;
  merchant_reference : text;
  order_id : nat64;
  last_failure : opt text;
  amount_refunded_minor : nat64;
};
type PaymentStatus = variant {
  Failed;
  Refunded;
  Paid;
  AwaitingPayment;
  CashOnDeliveryCollected;
  RefundPending;
  CashOnDeliveryPending;
  PartiallyRefunded;
  Expired;
};
type PlaceOrder = record {
  customer_phone : opt text;
  note : opt text;
  items : vec OrderItemRequest;
  // Required for prepaid orders and passed to the hosted payment provider.
  customer_email : opt text;
  customer_name : opt text;
  delivery_location : DeliveryLocation;
};
// One canister already installed in the project, identified by the stable
// Wasm artifact filename assigned by the package registry.
type ProjectCanister = record { canister_id : principal; package_name : text };
// Platform-owned context supplied when a package is installed.
type ProjectContext = record {
  canisters : vec ProjectCanister;
  project_id : text;
};
type RecordCashCollection = record {
  amount_minor : nat64;
  currency : text;
  order_id : nat64;
  receipt_reference : text;
};
type RecordPayment = record {
  amount_minor : nat64;
  transaction_id : text;
  provider : text;
  currency : text;
  merchant_reference : text;
  order_id : nat64;
};
type RecordPaymentFailure = record {
  provider : text;
  reference : text;
  order_id : nat64;
  reason : text;
};
type RecordRefund = record {
  amount_minor : nat64;
  transaction_id : text;
  provider : text;
  order_id : nat64;
};
type Result = variant { Ok : text; Err : text };
type Result_1 = variant { Ok : Order; Err : OrderError };
type Result_10 = variant { Ok; Err : text };
type Result_11 = variant { Ok; Err : OrderError };
type Result_2 = variant { Ok : InventoryItem; Err : OrderError };
type Result_3 = variant { Ok : nat64; Err : OrderError };
type Result_4 = variant { Ok : PaymentRecord; Err : OrderError };
type Result_5 = variant { Ok : Settings; Err : OrderError };
type Result_6 = variant { Ok : vec InventoryItem; Err : OrderError };
type Result_7 = variant { Ok : vec AuditEntry; Err : OrderError };
type Result_8 = variant { Ok : vec Order; Err : OrderError };
type Result_9 = variant { Ok : BusinessProfile; Err : OrderError };
type Settings = record {
  prepaid_reservation_ttl_ns : nat64;
  trusted_payment_processors : vec principal;
  staff : vec CustomerIdentity;
  business : BusinessProfile;
  trusted_agents : vec principal;
};
type UpdateInventoryItem = record {
  sku : opt text;
  price_minor : opt nat64;
  active : opt bool;
  // Sets the item's image URL; an empty string removes it.
  image_url : opt text;
  kind : opt InventoryKind;
  name : opt text;
  description : opt text;
  payment_method : opt PaymentMethod;
  currency : opt text;
  stock_quantity : opt nat64;
  // Set false to stop tracking stock; set true with `stock_quantity` to start.
  track_stock : opt bool;
};
service : (ProjectContext) -> {
  ai_add_inventory : (AiContext, text) -> (Result);
  ai_cancel_my_order : (AiContext, text) -> (Result);
  ai_get_my_order : (AiContext, text) -> (Result);
  ai_list_all_inventory : (AiContext, text) -> (Result);
  ai_list_inventory : (AiContext, text) -> (Result);
  ai_list_my_inventory : (AiContext, text) -> (Result);
  ai_list_my_orders : (AiContext, text) -> (Result);
  ai_list_order_audit : (AiContext, text) -> (Result);
  ai_list_orders : (AiContext, text) -> (Result);
  ai_place_order : (AiContext, text) -> (Result);
  ai_update_inventory : (AiContext, text) -> (Result);
  ai_update_order_status : (AiContext, text) -> (Result);
  cancel_my_order : (nat64) -> (Result_1);
  create_inventory : (CreateInventoryItem) -> (Result_2);
  expire_unpaid_orders : (nat64) -> (Result_3);
  get_business : () -> (BusinessProfile) query;
  get_config : () -> (vec record { text; ConfigValue }) query;
  get_config_schema : () -> (vec ConfigFieldSchema) query;
  get_inventory : (nat64) -> (opt InventoryItem) query;
  get_links : () -> (vec CanisterLink) query;
  get_order : (nat64) -> (Result_1) query;
  get_payment : (nat64) -> (Result_4) query;
  get_settings : () -> (Result_5) query;
  // Serves the embedded inventory admin UI under `/admin/` and the public
  // storefront at `/` (see `assets.rs`). Data calls still go through Candid
  // from the browser's authenticated identity.
  http_request : (HttpRequest) -> (HttpResponse) query;
  list_all_inventory : () -> (Result_6) query;
  list_audit : (opt nat64, nat64, nat64) -> (Result_7) query;
  list_inventory : () -> (vec InventoryItem) query;
  // The caller's own orders, newest first.
  list_my_orders : () -> (Result_8) query;
  list_orders : (opt OrderStatus) -> (Result_8) query;
  llm_context : () -> (text) query;
  place_order : (PlaceOrder) -> (Result_1);
  record_cash_collection : (RecordCashCollection) -> (Result_1);
  record_payment : (RecordPayment) -> (Result_1);
  record_payment_failure : (RecordPaymentFailure) -> (Result_4);
  record_refund : (RecordRefund) -> (Result_1);
  set_business : (BusinessProfile) -> (Result_9);
  set_config : (vec record { text; ConfigValue }) -> (Result_10);
  set_payment_processor : (principal, bool) -> (Result_11);
  set_prepaid_reservation_ttl_secs : (nat64) -> (Result_11);
  set_staff : (CustomerIdentity, bool) -> (Result_11);
  set_trusted_agent : (principal, bool) -> (Result_11);
  update_inventory : (nat64, UpdateInventoryItem) -> (Result_2);
  update_order_status : (nat64, OrderStatus) -> (Result_1);
  update_project_context : (ProjectContext) -> (Result_10);
}