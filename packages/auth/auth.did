// Minimal proof that this auth canister currently recognizes an identity.
// Private profile fields are intentionally excluded.
type Authorization = record { "principal" : opt principal; profile_id : nat64 };
type CanisterMetadata = record {
  name : text;
  description : text;
  version : text;
  canister_type : opt CanisterType;
};
type CanisterType = variant { Storage; Auth; Database; Custom };
type Config = record {
  // Application canisters allowed to resolve profile claims by principal.
  // Defaulting preserves CBOR compatibility with configurations written
  // before this field existed.
  trusted_canisters : vec principal;
  // Where a completed login redirects the browser back to, with
  // `?session=<token>` appended (e.g. `https://myapp.example.com/auth/callback`).
  // `None` means `http_request_update`'s OAuth callback renders the
  // token directly as a plain-text page instead of redirecting -
  // functional for testing, not what a real frontend integration wants.
  frontend_redirect_url : opt text;
  // Provider name (caller's own choice, e.g. "google", "github") ->
  // its settings. Candid has no map type of its own; candid's derive
  // renders a `BTreeMap` as `vec record { text; OAuthProviderConfig }`,
  // the same shape a hand-written `vec record {...}` field would have.
  providers : vec record { text; OAuthProviderConfig };
  // How long a session issued by a completed OAuth login stays valid -
  // see `state.rs::SessionRecord`.
  session_ttl_secs : nat64;
};
type ConfigFieldSchema = record {
  key : text;
  is_required : bool;
  field_type : ConfigType;
  description : text;
  label : text;
  group : opt text;
  group_label : opt text;
  group_description : opt text;
  // Optional typed filter for canister-picker fields. `None` has the
  // same meaning as `Some(CanisterType::Custom)`.
  canister_type : opt CanisterType;
  // True for canister-provided display data that set_config cannot mutate.
  is_readonly : opt bool;
  default_value : opt ConfigValue;
};
type ConfigVectorType = variant {
  Text; Number; Float; Boolean;
  Select : record { options : vec text };
  CanisterPicker : record { module_type_filter : opt text };
  SecretText;
};
type ConfigVectorValue = variant {
  Text : text; Number : int64; Float : float64; Boolean : bool; PrincipalId : principal;
};
type ConfigType = variant {
  Text;
  TextArea;
  CanisterPicker : record { module_type_filter : opt text };
  Boolean;
  Float;
  // Same wire shape as `Text`; `get_config` masks the value for any
  // caller that isn't a controller (see this module's doc comment).
  SecretText;
  Select : record { options : vec text };
  Number;
  Vector : record { element_type : ConfigVectorType };
};
// `update_config`'s argument. Providers remain managed separately. An outer
// `None` leaves a field untouched; the nested option for the redirect URL
// distinguishes clearing it from setting it. `Some(trusted_canisters)`
// replaces the complete allowlist.
type ConfigUpdate = record {
  // `None` leaves the allowlist unchanged; `Some` replaces it completely.
  trusted_canisters : opt vec principal;
  frontend_redirect_url : opt opt text;
  session_ttl_secs : opt nat64;
};
type ConfigValue = variant {
  Text : text;
  Boolean : bool;
  Float : float64;
  PrincipalId : principal;
  Number : int64;
  Vector : vec ConfigVectorValue;
};
type HttpRequest = record {
  url : text;
  method : text;
  body : blob;
  headers : vec record { text; text };
};
type HttpResponse = record {
  body : blob;
  headers : vec record { text; text };
  upgrade : opt bool;
  status_code : nat16;
};
// One external identity provider account linked to a `Profile` - a
// profile can have several (e.g. both "google" and "github"), each
// contributing at most one link, keyed by `(provider, subject)` in
// `state.rs`'s own index.
type OAuthLink = record {
  provider : text;
  // The provider's own stable id for this user (OIDC's "sub" claim, or
  // whatever the equivalent field is called - see `oauth::find_subject`) -
  // never the user's email, which a provider may let its users change.
  subject : text;
  // The email `oauth::exchange_code` read back from this provider at
  // link time - a snapshot, not re-verified on every login; a real
  // deployment that needs a always-current email should re-fetch it.
  email : opt text;
  linked_at : nat64;
};
// Everything needed to run the OAuth 2.0 Authorization Code flow against
// one provider (Google, GitHub, or any other OAuth2-compliant service) -
// see `oauth.rs` for how each field is used. Deliberately provider-agnostic:
// nothing here is Google- or GitHub-specific, the same as `agent`'s
// `llm_provider` isn't tied to one LLM vendor.
type OAuthProviderConfig = record {
  userinfo_url : text;
  authorize_url : text;
  // Must exactly match what's registered with the provider - typically
  // `https://<canister-id>.icp0.io/oauth/<provider-name>/callback` (or
  // the `*.raw.icp0.io` form if the provider's own redirect validation
  // rejects `icp0.io`'s HTML-certification wrapper - see README.md).
  redirect_uri : text;
  scope : text;
  token_url : text;
  client_id : text;
  // Kept in canister state the same way `connector`'s channel secrets
  // are (see that crate's `Config` doc comment) - controller-gated
  // `get_auth_config` is this template's access-control boundary for it, not
  // on-chain secret management (vetKD) - a real deployment with a
  // stricter threat model should consider that instead.
  client_secret : text;
};
// One user. Reachable two ways - see `lib.rs`'s module doc comment for
// the full design:
// - by `principal`, if this profile has ever been linked to an IC
// identity (`link_current_principal`) - `None` for an OAuth-only
// account that has never done that.
// - by a session token (`state.rs::SessionRecord`), issued each time an
// OAuth login completes - looked up via `get_profile_by_session`.
type Profile = record {
  id : nat64;
  updated_at : nat64;
  "principal" : opt principal;
  avatar_url : opt text;
  oauth_links : vec OAuthLink;
  created_at : nat64;
  email : opt text;
  display_name : opt text;
};
// Basic profile attributes suitable for application modules. OAuth links
// and provider-specific subjects stay private to the auth canister.
type ProfileClaims = record {
  "principal" : opt principal;
  avatar_url : opt text;
  email : opt text;
  display_name : opt text;
  profile_id : nat64;
};
type Result = variant { Ok : text; Err : text };
type Result_1 = variant { Ok : Config; Err : text };
type Result_2 = variant { Ok : opt Profile; Err : text };
type Result_3 = variant { Ok : Profile; Err : text };
type Result_4 = variant { Ok : vec Profile; Err : text };
type Result_5 = variant { Ok; Err : text };
type Result_6 = variant { Ok : opt ProfileClaims; Err : text };
// `update_my_profile`'s argument - only the fields a user may set about
// themselves (never `email`: that comes from a verified OAuth provider or
// stays unset, never a value the user can just assert - see
// `lib.rs::update_my_profile`). Three-state per field, matching every
// other building block's `ConfigUpdate` convention (see
// `connector::config::ConfigUpdate`'s doc comment): outer `None` leaves
// the field untouched, `Some(None)` clears it, `Some(Some(value))` sets
// it.
type UpdateProfile = record {
  avatar_url : opt opt text;
  display_name : opt opt text;
};
type LinkKind = variant { Admin; Public };
type CanisterLink = record { label : text; url : text; kind : LinkKind };
service : () -> {
  // Minimal, non-sensitive identity lookup for application canisters.
  authorize_principal : (principal) -> (opt Authorization) query;
  // Session-token counterpart used by HTTP API canisters, whose gateway
  // requests do not carry the end user's IC caller principal.
  authorize_session : (text) -> (opt Authorization) query;
  // Starts an OAuth login (or, if `link` is set, a request to link a new
  // provider onto the *caller's own already-authenticated* principal
  // profile) against `provider` - returns the URL to send the browser to.
  // An `#[update]`, not `#[query]`: generating a real CSRF `state` token
  // needs real randomness (`raw_rand`, itself an inter-canister call to the
  // management canister, which only an update call can make).
  begin_oauth : (text, bool) -> (Result);
  canister_metadata : () -> (CanisterMetadata) query;
  get_auth_config : () -> (Result_1) query;
  get_config : () -> (vec record { text; ConfigValue }) query;
  get_config_schema : () -> (vec ConfigFieldSchema) query;
  get_links : () -> (vec CanisterLink) query;
  // This caller's own profile - `None` if it has never called
  // `update_my_profile` (there's nothing to auto-create on a read-only
  // call). Rejects the anonymous principal, same as every other
  // caller-scoped method here.
  get_my_profile : () -> (Result_2) query;
  get_profile : (nat64) -> (Result_2) query;
  // A profile reached via a session token from a completed OAuth login -
  // the counterpart to `get_my_profile`'s principal-based lookup, for a
  // caller that only has a session token (a plain browser session, no IC
  // identity of its own). `None` for an invalid or expired token - see
  // `state::get_session`'s own doc comment on why the two aren't
  // distinguished.
  get_profile_by_session : (text) -> (opt Profile) query;
  // Recognizes `/oauth/<provider>/callback` (any `<provider>` - validated
  // for real once the `state` token is checked, see `handle_oauth_callback`)
  // and upgrades it to the update call, since handling it always mutates
  // state (issues a session, creates/updates a profile) - see `http.rs`'s
  // doc comment for why every such request must go through
  // `http_request_update`, never be handled directly in this query call.
  http_request : (HttpRequest) -> (HttpResponse) query;
  http_request_update : (HttpRequest) -> (HttpResponse);
  // Attaches the OAuth identity behind `session_token` (from a completed
  // `begin_oauth`/callback flow) to this caller's own principal-based
  // profile - the two-paths-become-one operation described in this crate's
  // module doc comment. Fails if `session_token` is invalid/expired, if
  // that OAuth identity is already linked to a *different* profile, or if
  // this caller's principal is already linked to a *different* profile than
  // the session's own (each profile has at most one principal).
  link_current_principal : (text) -> (Result_3);
  // Newest-first, paginated via `offset`/`limit`.
  list_profiles : (nat64, nat64) -> (Result_4) query;
  // A prose description of this canister for an AI agent (or a human
  // implementer) to consume - what it does, its security model, and how to
  // configure a real OAuth provider against it. Open to any caller, same
  // reasoning as every other building block's `llm_context`: nothing
  // sensitive in a description of the canister's own shape, and it needs to
  // be readable before anyone has credentials to call anything else here.
  llm_context : () -> (text) query;
  remove_oauth_provider : (text) -> (Result_5);
  // Returns basic profile attributes for a principal. Unlike
  // `authorize_principal`, this exposes personal data and is therefore limited
  // to controllers and explicitly trusted application canisters.
  resolve_principal : (principal) -> (Result_6) query;
  // Bearer-token counterpart. Possession of a valid unexpired session is the
  // authority to read that session's own basic profile attributes.
  resolve_session : (text) -> (opt ProfileClaims) query;
  set_config : (vec record { text; ConfigValue }) -> (Result_5);
  set_oauth_provider : (text, OAuthProviderConfig) -> (Result_5);
  update_config : (ConfigUpdate) -> (Result_5);
  // Creates this caller's profile on first call, or applies `update` to the
  // existing one - see `UpdateProfile`'s own doc comment for why `email`
  // isn't one of the fields it can set (that only ever comes from a
  // verified OAuth provider, via `link_current_principal`/a fresh OAuth
  // sign-in).
  update_my_profile : (UpdateProfile) -> (Result_3);
}
